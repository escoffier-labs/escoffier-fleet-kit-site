---
import { SITE, NAV_LINKS, EXTERNAL } from '../lib/site.ts';
import ThemeToggle from './ThemeToggle.astro';
import { Search } from 'lucide-react';
---
<nav class="flex items-center gap-6 px-6 md:px-10 py-4 border-b text-sm" style="border-color: var(--hairline);">
  <a href="/" class="font-mono font-medium text-base uppercase">{SITE.name}<span style="color: var(--accent);">_</span></a>
  {NAV_LINKS.map((l) => <a href={l.href} class="hidden sm:inline" style="color: var(--text-muted);">{l.label}</a>)}
  <span class="flex-1"></span>
  <button
    id="cmdkTrigger"
    type="button"
    class="hidden items-center gap-2 rounded-md border px-3 py-1.5 font-mono text-xs sm:inline-flex"
    style="border-color: var(--hairline); background: var(--bg-panel); color: var(--text-muted);"
    aria-label="Search escoffier-fleet-kit"
  >
    <Search size={14} aria-hidden="true" />
    <span>Search</span>
    <kbd class="rounded border px-1.5 py-0.5 text-[0.65rem]" style="border-color: var(--hairline-strong); color: var(--text-dim);">Ctrl K</kbd>
  </button>
  <a href={EXTERNAL.stargazers} class="inline-flex items-center" aria-label="Star on GitHub">
    <img class="stars-badge-dark" src={EXTERNAL.starsBadgeDark} alt="GitHub stars" height="32" loading="lazy" decoding="async" />
    <img class="stars-badge-light" src={EXTERNAL.starsBadgeLight} alt="GitHub stars" height="32" loading="lazy" decoding="async" />
  </a>
  <ThemeToggle />
</nav>
